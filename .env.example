# Leetify Public API key — sent in the `_leetify_key` request header to raise
# rate limits. Get one from https://leetify.com (developer/API settings).
# Copy this file to `.env.local` for local dev. In CI, set the same name as a
# GitHub Actions secret so it gets injected at build time.
VITE_LEETIFY_KEY=

# Optional: URL of the Steam avatar proxy Worker (see worker/README.md). When
# set, the widget shows the player's Steam avatar. This is just a public URL,
# not a secret, so it's safe to inline at build time. For the deployed site set
# a GitHub Actions repository variable named VITE_AVATAR_PROXY_URL. The Steam
# API key itself lives only on the Worker, never here.
VITE_AVATAR_PROXY_URL=
